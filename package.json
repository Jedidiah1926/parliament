{
  "name": "hemicycle",
  "productName": "Hemicycle",
  "version": "1.6.6",
  "description": "Hemicycle — desktop build",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "smoketest": "electron electron/smoketest.js",
    "build:logo": "node tools/build-logo.js",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:demo": "node tools/build-demo.js && electron-builder --config electron-builder.demo.js --win dir"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^4.2.2",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3"
  },
  "build": {
    "appId": "com.pilcrow1926.hemicycle",
    "productName": "Hemicycle",
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "files": [
      "electron/**/*",
      "*.html",
      "js/**/*",
      "css/**/*",
      "fonts/**/*",
      "presets/**/*",
      "lang/**/*",
      "old2/**/*",
      "icons/**/*",
      "!electron/smoketest.js",
      "!README.md",
      "!package.json",
      "!package-lock.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jedidiah1926",
        "repo": "parliament"
      }
    ],
    "detectUpdateChannel": false
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
